# ---------------------------------------------------------------------------
# ModelScope access tokens, comma separated. Multiple tokens are rotated
# round-robin; a token that fails with an auth/quota error is skipped and
# retried with the next one.
# Get yours at https://modelscope.cn/my/myaccesstoken
# ---------------------------------------------------------------------------
MODELSCOPE_TOKENS=ms-xxxxxxxx,ms-yyyyyyyy

# The API key clients must present to this proxy. Leave empty to disable
# authentication (only appropriate for local/trusted networks).
PROXY_API_KEY=change-me

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn
# MODELSCOPE_TASK_TYPE=image_generation

# Total time a request may block waiting for the upstream task, in seconds.
# PROXY_REQUEST_TIMEOUT=300

# Polling backoff bounds, in seconds.
# PROXY_POLL_INITIAL_INTERVAL=2
# PROXY_POLL_MAX_INTERVAL=10
# PROXY_POLL_BACKOFF=1.5

# Upstream HTTP timeouts, in seconds.
# PROXY_CONNECT_TIMEOUT=15
# PROXY_UPSTREAM_TIMEOUT=60

# How many tokens to try when a submission fails. 0 means "every token once".
# PROXY_MAX_TOKEN_ATTEMPTS=0
